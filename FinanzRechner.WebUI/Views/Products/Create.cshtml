@model FinanzRechner.WebUI.ViewModels.Products.ProductEditViewModel

@{
    ViewData["Title"] = "Create Product";
    var productsSelectList = (ViewBag.ProductsSelectList as SelectList)
        ?? new SelectList(Enumerable.Empty<SelectListItem>());
        
    var workstationsSelectList = (ViewData["WorkstationsSelectList"] as SelectList)
        ?? new SelectList(Enumerable.Empty<SelectListItem>());
        
    var jobPositionsSelectList = (ViewData["JobPositionsSelectList"] as SelectList)
        ?? new SelectList(Enumerable.Empty<SelectListItem>());
}

<h1>Create Product</h1>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="Designation" class="control-label"></label>
        <input asp-for="Designation" class="form-control" />
        <span asp-validation-for="Designation" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Name" class="control-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <hr />
    <h4>BOM (Состав изделия)</h4>

    <table class="table" id="bomTable">
        <thead>
            <tr>
                <th>Дочерний продукт</th>
                <th>Количество</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.BomLines.Count; i++)
            {
                <tr>
                    <td>
                        <select asp-for="BomLines[@i].ChildProductId"
                                class="form-control"
                                asp-items="productsSelectList">
                            <option value="">-- выберите продукт --</option>
                        </select>
                    </td>
                    <td>
                        <input asp-for="BomLines[@i].Quantity"
                               class="form-control" />
                    </td>
                    <td>
                        <button type="button" class="btn btn-sm btn-danger"
                                onclick="removeBomRow(this)">
                            X
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button type="button" class="btn btn-secondary" onclick="addBomRow()">Добавить строку</button>

    <hr />
    <h4>BOP (Техпроцесс изделия)</h4>

    <table class="table" id="bopTable">
        <thead>
            <tr>
                <th style="width: 80px;">Seq</th>
                <th>Operation</th>
                <th>Workstation</th>
                <th>Job Position</th>
                <th style="width: 120px;">Duration (min)</th>
                <th style="width: 50px;"></th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.BopLines.Count; i++)
            {
                <tr>
                    <td>
                        <input asp-for="BopLines[@i].Sequence" class="form-control" />
                    </td>
                    <td>
                        <select asp-for="BopLines[@i].Operation" class="form-control" asp-items="Model.OperationOptions">
                            <option value="">-- операция --</option>
                        </select>
                    </td>
                    <td>
                        <select asp-for="BopLines[@i].WorkstationId" class="form-control" asp-items="workstationsSelectList">
                            <option value="">-- станок --</option>
                        </select>
                    </td>
                    <td>
                        <select asp-for="BopLines[@i].JobPositionId" class="form-control" asp-items="jobPositionsSelectList">
                            <option value="">-- должность --</option>
                        </select>
                    </td>
                    <td>
                        <input asp-for="BopLines[@i].Duration" class="form-control" type="number" step="0.1" />
                    </td>
                    <td>
                        <button type="button" class="btn btn-sm btn-danger" onclick="removeBopRow(this)">X</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button type="button" class="btn btn-secondary" onclick="addBopRow()">Добавить операцию</button>

    <hr />
    <h4>Сырьё и материалы</h4>

    <table class="table" id="materialTable">
        <thead>
            <tr>
                <th style="width: 400px;">Материал</th>
                <th>Количество</th>
                <th style="width: 50px;"></th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < Model.MaterialLines.Count; i++)
            {
                <tr>
                    <td>
                        <select asp-for="MaterialLines[i].MaterialId"
                                class="form-control"
                                asp-items="@(ViewBag.MaterialsSelectList as SelectList ?? new SelectList(Enumerable.Empty<SelectListItem>()))">
                            <option value="">-- выберите материал --</option>
                        </select>
                        <span asp-validation-for="MaterialLines[i].MaterialId" class="text-danger"></span>
                    </td>
                    <td>
                        <input asp-for="MaterialLines[i].Quantity" class="form-control" type="number" step="0.0001" />
                        <span asp-validation-for="MaterialLines[i].Quantity" class="text-danger"></span>
                    </td>
                    <td>
                        <button type="button" class="btn btn-sm btn-danger" onclick="removeMaterialRow(this)">X</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button type="button" class="btn btn-secondary" onclick="addMaterialRow()">Добавить материал</button>
    <div class="form-group mt-3">
        <input type="submit" value="Create" class="btn btn-primary" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
                function addBomRow() {
                    const tableBody = document.querySelector("#bomTable tbody");
                    const rowCount = tableBody.rows.length;

                    const template = `
        <tr>
            <td>
                <select name="BomLines[${rowCount}].ChildProductId" class="form-control">
                    <option value="">-- выберите продукт --</option>
                    @foreach (var item in productsSelectList)
                    {
                                <text><option value="@item.Value">@item.Text</option></text>
                    }
                </select>
            </td>
            <td>
                <input name="BomLines[${rowCount}].Quantity" class="form-control" value="1" />
            </td>
            <td>
                <button type="button" class="btn btn-sm btn-danger" onclick="removeBomRow(this)">X</button>
            </td>
        </tr>`;

                    tableBody.insertAdjacentHTML('beforeend', template);
                }

                function removeBomRow(btn) {
                    const row = btn.closest("tr");
                    row.remove();
                }
    </script>

    <script>
        function addBopRow() {
            const tableBody = document.querySelector("#bopTable tbody");
            const rowCount = tableBody.rows.length;

            // Подготавливаем опции для станков и должностей
            let workstationOptions = '<option value="">-- станок --</option>';
            @foreach (var item in workstationsSelectList)
            {
                    <text>workstationOptions += '<option value="@item.Value">@item.Text</option>';</text>
            }

            let jobOptions = '<option value="">-- должность --</option>';
            @foreach (var item in jobPositionsSelectList)
            {
                    <text>jobOptions += '<option value="@item.Value">@item.Text</option>';</text>
            }

            let operationOptions = '<option value="">-- операция --</option>';
            @foreach (var item in Model.OperationOptions)
            {
                    <text>operationOptions += '<option value="@item.Value">@item.Text</option>';</text>
            }

            const template = `
            <tr>
                <td>
                    <input name="BopLines[${rowCount}].Sequence" class="form-control" value="${rowCount + 1}" />
                </td>
                <td>
                    <select name="BopLines[${rowCount}].Operation" class="form-control">
                        ${operationOptions}
                    </select>
                </td>
                <td>
                    <select name="BopLines[${rowCount}].WorkstationId" class="form-control">
                        ${workstationOptions}
                    </select>
                </td>
                <td>
                    <select name="BopLines[${rowCount}].JobPositionId" class="form-control">
                        ${jobOptions}
                    </select>
                </td>
                <td>
                    <input name="BopLines[${rowCount}].Duration" class="form-control" type="number" step="0.1" value="1.0" />
                </td>
                <td>
                    <button type="button" class="btn btn-sm btn-danger" onclick="removeBopRow(this)">X</button>
                </td>
            </tr>`;

            tableBody.insertAdjacentHTML('beforeend', template);
        }

        function removeBopRow(btn) {
            btn.closest("tr").remove();
            reindexBopRows();
        }

        function reindexBopRows() {
            const rows = document.querySelectorAll("#bopTable tbody tr");
            rows.forEach((row, index) => {
                row.querySelectorAll("input, select").forEach(el => {
                    const name = el.name;
                    if (name) {
                        el.name = name.replace(/\[\d+\]/, `[${index}]`);
                    }
                });
            });
        }
    </script>
    <script>
            function addMaterialRow() {
            const tableBody = document.querySelector("#materialTable tbody");
            const rowCount = tableBody.rows.length;

            // Подготавливаем опции заранее, чтобы не загромождать шаблон
            let options = '<option value="">-- выберите материал --</option>';
    
            @if (ViewBag.MaterialsSelectList != null)
            {
                    foreach (var item in (SelectList)ViewBag.MaterialsSelectList)
                    {
                            <text>options += '<option value="@item.Value">@item.Text</option>';</text>
                    }
            }

            const template = `
            <tr>
                <td>
                    <select name="MaterialLines[${rowCount}].MaterialId" class="form-control">
                        ${options}
                    </select>
                </td>
                <td>
                    <input name="MaterialLines[${rowCount}].Quantity" class="form-control" type="number" step="0.0001" value="1" />
                </td>
                <td>
                    <button type="button" class="btn btn-sm btn-danger" onclick="removeMaterialRow(this)">X</button>
                </td>
            </tr>`;

            tableBody.insertAdjacentHTML('beforeend', template);
        }

    function removeMaterialRow(btn) {
    const row = btn.closest("tr");
    row.remove();
    
    reindexMaterialRows();
    }

           function reindexMaterialRows() {
            const rows = document.querySelectorAll("#materialTable tbody tr");
            rows.forEach((row, index) => {
                const select = row.querySelector("select");
                const input = row.querySelector("input[type='number']");
        
                if(select) select.name = `MaterialLines[${index}].MaterialId`;
                if(input) input.name = `MaterialLines[${index}].Quantity`;
            });
        }
    </script>
}
