@using FinancialCalc.Domain.Entities
@using FinancialCalc.Domain.Enums
@model FinancialCalc.WebUI.ViewModels.Products.JobPosition.JobPositionViewModel

@{
    ViewData["Title"] = "Создание должности";
}

<h1>Создать</h1>

<h4>Должность (JobPosition)</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <div class="form-group mb-3">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="BaseHourlyRate" class="control-label"></label>
                <input asp-for="BaseHourlyRate" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="BaseHourlyRate" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Severity" class="control-label"></label>
                <select asp-for="Severity" class="form-control"
                        asp-items="Html.GetEnumSelectList<SeverityCategory>()">
                    <option value="">-- Выберите категорию --</option>
                </select>
                <span asp-validation-for="Severity" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Создать" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Отмена</a>
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">Назад к списку</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}