@model FinancialCalc.WebUI.ViewModels.Products.JobPosition.JobPositionViewModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>JobPosition</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Title)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Title)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.BaseHourlyRate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.BaseHourlyRate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Severity)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Severity)
        </dd>
        <dt class="col-sm-2">
            Final Rate
        </dt>
        <dd class="col-sm-10">
            @Model.FinalRate.ToString("F2")
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> |
    <a asp-action="Index">Back to List</a>
